<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>BioOxy Pod</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@500;600;700&family=IBM+Plex+Sans+Thai:wght@300;400;500;600&display=swap">
<style>
/* Layout: one dark presentation page, a white band for the variables section, sticky section nav, hero with an animated algae pod. */
:root {
  --ink: #06100e;
  --ink-2: #0c1b18;
  --line: #1c3a34;
  --sea: #27d3ae;
  --sea-deep: #0e8a73;
  --paper: #f3f8f6;
  --paper-ink: #0a1a17;
  --text: #eef6f4;
  --muted: #93aca6;
  --paper-muted: #4b625c;
  --f-display: 'Bai Jamjuree', 'Noto Sans Thai', system-ui, sans-serif;
  --f-body: 'IBM Plex Sans Thai', 'Noto Sans Thai', system-ui, sans-serif;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--ink);
  color: var(--text);
  font-family: var(--f-body);
  font-size: 16px;
  line-height: 1.75;
  margin: 0;
  padding-inline: 0;
}
h1, h2, h3 { font-family: var(--f-display); text-wrap: balance; margin: 0; line-height: 1.2; }
p { margin: 0; }
.wrap { width: 100%; max-width: 1040px; margin-inline: auto; padding-inline: 20px; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--sea); outline-offset: 3px; }

/* nav */
.nav {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10;
  background: rgba(6,16,14,.92); backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--line);
}
.nav .wrap { display: flex; align-items: center; gap: 20px; overflow-x: auto; padding-block: 10px; scrollbar-width: none; }
.nav .brand { font-family: var(--f-display); font-weight: 700; color: var(--sea); white-space: nowrap; letter-spacing: .02em; }
.nav a.item { color: var(--muted); text-decoration: none; font-size: 14px; white-space: nowrap; padding: 4px 0; border-bottom: 2px solid transparent; }
.nav a.item:hover { color: var(--text); border-bottom-color: var(--sea); }

/* hero */
.hero { padding-block: 56px 48px; border-bottom: 1px solid var(--line); }
.hero .wrap { display: grid; grid-template-columns: 1.25fr 1fr; gap: 32px; align-items: center; }
.kicker { font-size: 13px; letter-spacing: .14em; color: var(--sea); text-transform: uppercase; font-weight: 500; }
.hero h1 { font-size: clamp(2.6rem, 8vw, 5rem); font-weight: 700; margin-block: 12px 6px; }
.hero h1 span { color: var(--sea); }
.hero .sub { font-family: var(--f-display); font-size: clamp(1.1rem, 3vw, 1.5rem); color: var(--text); font-weight: 500; }
.hero .lead { color: var(--muted); max-width: 52ch; margin-top: 16px; }
.hero .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
.chip { border: 1px solid var(--line); border-radius: 999px; padding: 4px 14px; font-size: 13px; color: var(--muted); }
.chip b { color: var(--sea); font-weight: 600; }
.pod { width: 100%; max-width: 340px; justify-self: center; height: auto; }
.bub { fill: var(--sea); opacity: .0; animation: rise 5s linear infinite; }
@keyframes rise { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: .85; } 100% { transform: translateY(-230px); opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .bub { animation: none; opacity: .7; } html { scroll-behavior: auto; } }

/* sections */
section { padding-block: 64px; border-bottom: 1px solid var(--line); }
.sec-head { display: flex; align-items: baseline; gap: 16px; margin-bottom: 28px; flex-wrap: wrap; }
.sec-no { font-family: var(--f-display); font-weight: 700; font-size: clamp(2.6rem, 8vw, 4.2rem); color: var(--sea); line-height: 1; }
.sec-head h2 { font-size: clamp(1.5rem, 4.5vw, 2.2rem); font-weight: 600; }
.prose { max-width: 66ch; color: var(--text); }
.prose p + p { margin-top: 1em; }
.prose em { color: var(--sea); font-style: normal; font-weight: 500; }

.problem { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; margin-top: 32px; }
.problem div { background: var(--ink-2); border: 1px solid var(--line); border-radius: 6px; padding: 16px 18px; }
.problem small { display: block; color: var(--sea); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
.problem strong { font-family: var(--f-display); font-size: 1.15rem; font-weight: 600; }

/* lists */
.rows { display: grid; gap: 0; border-top: 1px solid var(--line); }
.row { display: grid; grid-template-columns: 56px 1fr; gap: 12px; padding-block: 18px; border-bottom: 1px solid var(--line); }
.row .n { font-family: var(--f-display); font-weight: 700; color: var(--sea); font-size: 1.4rem; }
.row p { max-width: 62ch; }

/* paper band */
.paper { background: var(--paper); color: var(--paper-ink); border-bottom: none; }
.paper .sec-no { color: var(--sea-deep); }
.vars { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
.var { border: 2px solid var(--paper-ink); border-radius: 6px; padding: 20px; background: #fff; min-width: 0; }
.var.ind { background: var(--paper-ink); color: var(--paper); }
.var .tag { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--sea-deep); }
.var.ind .tag { color: var(--sea); }
.var h3 { font-size: 1.3rem; margin-block: 6px 10px; }
.var p, .var li { color: var(--paper-muted); font-size: 15px; }
.var.ind p { color: #b8cbc6; }
.var ul { margin: 0; padding-left: 1.2em; }

/* results */
.two { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 32px; }
.panel { background: var(--ink-2); border: 1px solid var(--line); border-radius: 8px; padding: 24px; min-width: 0; }
.panel h3 { font-size: 1.15rem; font-weight: 600; margin-bottom: 4px; }
.panel .cap { color: var(--muted); font-size: 14px; margin-bottom: 18px; }
.big { font-family: var(--f-display); font-weight: 700; font-size: clamp(2.2rem, 7vw, 3.2rem); color: var(--sea); line-height: 1.1; font-variant-numeric: tabular-nums; }
.big small { font-size: .45em; color: var(--muted); font-weight: 500; margin-left: 6px; }
.scale { margin-top: 22px; }
.scale svg { width: 100%; height: auto; display: block; }
.scale text { fill: var(--muted); font-family: var(--f-body); font-size: 12px; }
.scale .strong { fill: var(--text); font-weight: 500; }
.pts { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.pts li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; }
.pts i { width: 10px; height: 10px; background: var(--sea); border-radius: 2px; margin-top: 10px; display: block; }
.edp { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.edp span { border: 1px solid var(--sea-deep); color: var(--sea); padding: 3px 12px; border-radius: 4px; font-size: 14px; }

/* conclusion */
.concl { background: linear-gradient(180deg, var(--ink) 0%, #0a2a24 100%); border-bottom: none; }
.quote { font-family: var(--f-display); font-size: clamp(1.25rem, 3.6vw, 1.9rem); font-weight: 600; line-height: 1.45; max-width: 30ch; margin-bottom: 28px; }
.quote span { color: var(--sea); }
.three { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; margin-top: 36px; }
.three div { border-top: 3px solid var(--sea); padding-top: 12px; color: var(--muted); font-size: 15px; }
.three b { display: block; color: var(--text); font-family: var(--f-display); font-size: 1.1rem; font-weight: 600; }
footer { padding-block: 28px calc(28px + env(safe-area-inset-bottom, 0px)); color: var(--muted); font-size: 13px; background: #0a2a24; }

@media (max-width: 760px) {
  .hero .wrap { grid-template-columns: 1fr; }
  .pod { max-width: 240px; order: -1; }
  section { padding-block: 48px; }
  .row { grid-template-columns: 40px 1fr; }
}
</style>
</head>
<body>

<nav class="nav" aria-label="สารบัญ">
  <div class="wrap">
    <span class="brand">BioOxy Pod</span>
    <a class="item" href="#s1">ที่มา</a>
    <a class="item" href="#s2">วัตถุประสงค์</a>
    <a class="item" href="#s3">สมมุติฐาน</a>
    <a class="item" href="#s4">ขอบเขต</a>
    <a class="item" href="#s5">ผล</a>
    <a class="item" href="#s6">สรุป</a>
  </div>
</nav>

<header class="hero">
  <div class="wrap">
    <div>
      <div class="kicker">นำเสนอโครงงาน</div>
      <h1>ต้นไม้เหลว<br><span>BioOxy Pod</span></h1>
      <p class="sub">ต้นไม้เหลวจากสาหร่าย ปรับอากาศในบ้าน และตกแต่งห้องในเวลาเดียวกัน</p>
      <p class="lead">สาหร่ายขนาดเล็กสังเคราะห์แสงเพื่อดูดซับคาร์บอนไดออกไซด์และผลิตออกซิเจน ในพื้นที่จำกัดของที่อยู่อาศัยในเมือง</p>
      <div class="meta">
        <span class="chip">ทดสอบต่อเนื่อง <b>30 วัน</b></span>
        <span class="chip">ค่า pH <b>6.4–6.9</b></span>
        <span class="chip">วิธีแก้ปัญหา <b>EDP</b></span>
      </div>
    </div>
    <svg class="pod" viewBox="0 0 300 380" role="img" aria-label="ภาพวาดตัวอย่าง BioOxy Pod ถังน้ำสีเขียวทะเลมีฟองออกซิเจนลอยขึ้น">
      <defs>
        <linearGradient id="liq" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#27d3ae"/>
          <stop offset="1" stop-color="#0e8a73"/>
        </linearGradient>
        <clipPath id="tube"><rect x="80" y="40" width="140" height="270" rx="70"/></clipPath>
      </defs>
      <rect x="80" y="40" width="140" height="270" rx="70" fill="#0c1b18" stroke="#27d3ae" stroke-width="3"/>
      <g clip-path="url(#tube)">
        <rect x="80" y="90" width="140" height="230" fill="url(#liq)" opacity=".88"/>
        <path d="M80 92 Q115 78 150 92 T220 92 V100 H80Z" fill="#6ff0d0" opacity=".7"/>
        <circle class="bub" cx="115" cy="290" r="5" style="animation-delay:0s"/>
        <circle class="bub" cx="150" cy="295" r="7" style="animation-delay:1.2s"/>
        <circle class="bub" cx="185" cy="288" r="4" style="animation-delay:2.4s"/>
        <circle class="bub" cx="132" cy="296" r="3.5" style="animation-delay:3.1s"/>
        <circle class="bub" cx="170" cy="292" r="5.5" style="animation-delay:3.9s"/>
        <circle class="bub" cx="200" cy="296" r="3" style="animation-delay:.7s"/>
      </g>
      <rect x="60" y="310" width="180" height="22" rx="4" fill="#eef6f4"/>
      <rect x="95" y="332" width="110" height="26" rx="4" fill="#1c3a34"/>
      <circle cx="150" cy="345" r="4" fill="#27d3ae"/>
      <text x="150" y="26" text-anchor="middle" fill="#27d3ae" font-family="IBM Plex Sans Thai, sans-serif" font-size="13">O₂ ↑</text>
    </svg>
  </div>
</header>

<main>
<section id="s1">
  <div class="wrap">
    <div class="sec-head"><span class="sec-no">1</span><h2>ที่มาและความสำคัญของปัญหา</h2></div>
    <div class="prose">
      <p>ปัญหามลพิษทางอากาศ โดยเฉพาะฝุ่น <em>PM2.5</em> และ <em>PM10</em> ที่รุนแรงในชุมชนเมืองที่มีความหนาแน่นสูงเป็นปัญหาสำคัญระดับโลก ส่งผลกระทบต่อสุขภาพอย่างรุนแรง เช่น โรคหลอดเลือดสมองและมะเร็งปอด</p>
      <p>มลพิษเหล่านี้ส่วนใหญ่เกิดจากการใช้พลังงานในภาคอุตสาหกรรม การจราจร และกิจกรรมอื่น ๆ ในเมือง</p>
      <p>คณะผู้จัดทำจึงพัฒนา <em>BioOxy Pod</em> นวัตกรรม “ต้นไม้เหลวจากสาหร่าย” ที่ใช้สาหร่ายขนาดเล็กสังเคราะห์แสงดูดซับก๊าซคาร์บอนไดออกไซด์และผลิตออกซิเจน เพื่อปรับปรุงสภาพอากาศภายในบ้านในพื้นที่จำกัด และเป็นทางเลือกในการตกแต่งบ้าน</p>
    </div>
    <div class="problem">
      <div><small>ปัญหา</small><strong>ฝุ่น PM2.5 และ PM10</strong></div>
      <div><small>ผลกระทบ</small><strong>หลอดเลือดสมอง มะเร็งปอด</strong></div>
      <div><small>แนวทาง</small><strong>สาหร่ายสังเคราะห์แสงในบ้าน</strong></div>
    </div>
  </div>
</section>

<section id="s2">
  <div class="wrap">
    <div class="sec-head"><span class="sec-no">2</span><h2>วัตถุประสงค์</h2></div>
    <div class="rows">
      <div class="row"><span class="n">2.1</span><p>พัฒนาเครื่องมือทางเทคโนโลยีชีวภาพ BioOxy Pod ซึ่งมีส่วนในการปรับปรุงสภาพอากาศ และเป็นอุปกรณ์ตกแต่งบ้านได้ในเวลาเดียวกัน</p></div>
      <div class="row"><span class="n">2.2</span><p>ประเมินความพึงพอใจจากการทดลองใช้ BioOxy Pod เป็นอุปกรณ์ตกแต่งบ้าน</p></div>
      <div class="row"><span class="n">2.3</span><p>วัดปริมาณ pH ในน้ำ</p></div>
    </div>
  </div>
</section>

<section id="s3">
  <div class="wrap">
    <div class="sec-head"><span class="sec-no">3</span><h2>สมมุติฐาน</h2></div>
    <div class="rows">
      <div class="row"><span class="n">3.1</span><p>โค้ดสั่งการสามารถสั่งการได้จริงตามคำสั่ง</p></div>
      <div class="row"><span class="n">3.2</span><p>BioOxy Pod สามารถผลิตออกซิเจนได้จริง</p></div>
    </div>
  </div>
</section>

<section id="s4" class="paper">
  <div class="wrap">
    <div class="sec-head"><span class="sec-no">4</span><h2>ขอบเขตการทำงานของโครงงาน “โครงงานต้นไม้เหลว”</h2></div>
    <div class="vars">
      <div class="var ind">
        <span class="tag">ตัวแปรต้น</span>
        <h3>ค่า pH ของน้ำ</h3>
        <p>ค่าที่ปรับและติดตามด้วยเซ็นเซอร์</p>
      </div>
      <div class="var">
        <span class="tag">ตัวแปรตาม</span>
        <h3>การเจริญเติบโตของสาหร่าย</h3>
        <p>ผลที่เปลี่ยนไปตามค่า pH</p>
      </div>
      <div class="var">
        <span class="tag">ตัวแปรควบคุม</span>
        <h3>ปัจจัยที่คงที่</h3>
        <ul>
          <li>ชนิดของสาหร่าย</li>
          <li>ปริมาณเริ่มต้นของสาหร่าย</li>
          <li>อุณหภูมิ</li>
          <li>แสง</li>
          <li>สารอาหาร</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section id="s5">
  <div class="wrap">
    <div class="sec-head"><span class="sec-no">5</span><h2>อธิบายผล</h2></div>
    <div class="prose">
      <p>คณะผู้จัดทำใช้กระบวนการออกแบบเชิงวิศวกรรม (EDP) แก้ปัญหาเซ็นเซอร์วัดค่า pH ที่คลาดเคลื่อน โดยปรับแก้โค้ดการวัดค่าให้ถูกต้อง</p>
      <div class="edp" aria-hidden="true"><span>พบปัญหา</span><span>ปรับแก้โค้ด</span><span>ทดสอบซ้ำ</span><span>ได้ค่าที่ถูกต้อง</span></div>
    </div>

    <div class="two">
      <div class="panel">
        <h3>ค่า pH ตลอด 30 วัน</h3>
        <p class="cap">อยู่ในช่วง “ดีมาก” และเหมาะที่สุดต่อการสังเคราะห์แสงของสาหร่าย</p>
        <div class="big">6.4 – 6.9<small>pH</small></div>
        <div class="scale">
          <svg viewBox="0 0 400 90" role="img" aria-label="แถบ pH 5 ถึง 8 ช่วงดีมาก 6 ถึง 7 ค่าที่วัดได้ 6.4 ถึง 6.9">
            <!-- scale: pH 5 -> x=20, pH 8 -> x=380, 120px per pH unit -->
            <rect x="20" y="30" width="360" height="22" rx="3" fill="#12251f"/>
            <rect x="140" y="30" width="120" height="22" fill="#0e8a73" opacity=".45"/>
            <rect x="188" y="30" width="72" height="22" fill="#27d3ae"/>
            <line x1="140" y1="22" x2="140" y2="60" stroke="#93aca6" stroke-width="1"/>
            <line x1="260" y1="22" x2="260" y2="60" stroke="#93aca6" stroke-width="1"/>
            <text x="20" y="76" text-anchor="middle">5</text>
            <text x="140" y="76" text-anchor="middle">6</text>
            <text x="260" y="76" text-anchor="middle">7</text>
            <text x="380" y="76" text-anchor="middle">8</text>
            <text x="200" y="16" text-anchor="middle">ช่วงดีมาก 6–7</text>
            <text x="224" y="45" text-anchor="middle" fill="#06100e" style="fill:#06100e;font-weight:600">วัดได้ 6.4–6.9</text>
          </svg>
        </div>
      </div>

      <div class="panel">
        <h3>ความพึงพอใจของผู้ใช้</h3>
        <p class="cap">กลุ่มตัวอย่างส่วนใหญ่ให้ความเห็นว่า</p>
        <ul class="pts">
          <li><i></i><span>ผลิตภัณฑ์มีดีไซน์สวยงาม เหมาะสำหรับ<b>ตกแต่งบ้าน</b>เป็นหลัก</span></li>
          <li><i></i><span>รับรู้ประโยชน์ด้าน<b>คุณภาพอากาศ</b>และ<b>ความผ่อนคลาย</b></span></li>
          <li><i></i><span>ระบุว่า<b>น่าจะซื้อ</b> หากมีการวางจำหน่าย</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section id="s6" class="concl">
  <div class="wrap">
    <div class="sec-head"><span class="sec-no">6</span><h2>สรุปผลการทดลอง</h2></div>
    <p class="quote">เครื่องมือเดียว ที่ <span>ปรับอากาศ</span> และ <span>ตกแต่งห้อง</span> ด้วยความงามจากธรรมชาติ</p>
    <div class="prose">
      <p>โครงงานนี้พัฒนาเครื่องมือทางเทคโนโลยีที่ช่วยปรับปรุงคุณภาพอากาศในพื้นที่จำกัด และตกแต่งห้องของผู้ใช้งานให้สวยงามจากธรรมชาติ ด้วย BioOxy Pod ที่ดูดซับก๊าซคาร์บอนไดออกไซด์และผลิตออกซิเจน เพื่อช่วยลดมลพิษทางอากาศ</p>
